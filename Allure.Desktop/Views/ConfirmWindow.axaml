<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Allure.Desktop.Views.ConfirmWindow"
        Title="Подтверждение"
        Width="420" Height="200"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <StackPanel Spacing="14" Margin="20">
        <TextBlock x:Name="MessageText" Foreground="#3E2723" TextWrapping="Wrap"/>
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Content="Нет" Click="OnNo"/>
            <Button Content="Да" Click="OnYes"/>
        </StackPanel>
    </StackPanel>
</Window>
