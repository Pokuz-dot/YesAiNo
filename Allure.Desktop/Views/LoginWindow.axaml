<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Allure.Desktop.Views.LoginWindow"
        Title="Аллюр — Вход в систему"
        Width="440" Height="560"
        MinWidth="400" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        CanResize="True">

    <StackPanel Width="330" Spacing="0" HorizontalAlignment="Center" VerticalAlignment="Center">
        <TextBlock Text="Конноспортивный клуб «Аллюр»"
                   FontSize="17" FontWeight="Bold" Foreground="#3E2723"
                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
        <TextBlock Text="Авторизация"
                   FontSize="28" FontWeight="Bold" Foreground="#3E2723"
                   HorizontalAlignment="Center" Margin="0,12,0,0"/>

        <TextBox PlaceholderText="Введите логин..."
                 Text="{Binding Login}"
                 Margin="0,24,0,0"
                 IsEnabled="{Binding !IsLocked}"/>

        <TextBox PlaceholderText="Введите пароль..."
                 PasswordChar="{Binding PasswordChar}"
                 Text="{Binding Password}"
                 Margin="0,14,0,0"
                 IsEnabled="{Binding !IsLocked}"/>

        <CheckBox Content="Показать пароль"
                  IsChecked="{Binding ShowPassword}"
                  Margin="0,10,0,0"/>

        <Button Content="Войти"
                Command="{Binding LoginCommand}"
                HorizontalAlignment="Stretch"
                Margin="0,18,0,0"
                IsEnabled="{Binding !IsLocked}"/>

        <TextBlock Text="{Binding ErrorMessage}"
                   Foreground="#C62828" FontSize="13" TextWrapping="Wrap"
                   Margin="0,12,0,0"/>

        <TextBlock Text="{Binding LockoutText}"
                   Foreground="#E65100" FontWeight="Bold" FontSize="14"
                   Margin="0,6,0,0"/>

        <TextBlock Text="Демо-доступ: bereitor / bereitor123, admin / admin123"
                   FontSize="12" Foreground="#8D6E63" TextWrapping="Wrap"
                   Margin="0,18,0,0"/>
    </StackPanel>
</Window>
