<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Allure.Desktop.App"
             RequestedThemeVariant="Light">

    <Application.Styles>
        <FluentTheme />

        <!-- Общий фон приложения (мягкий песочно-бежевый) -->
        <Style Selector="Window">
            <Setter Property="Background" Value="#EAE0D5"/>
        </Style>

        <!-- Поля ввода (белые с коричневой рамкой) -->
        <Style Selector="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#3E2723"/>
            <Setter Property="BorderBrush" Value="#8D6E63"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Основные кнопки (оранжевые) -->
        <Style Selector="Button">
            <Setter Property="Background" Value="#E65100"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="14,0"/>
        </Style>

        <!-- Наведение на кнопку -->
        <Style Selector="Button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#F57C00"/>
            <Setter Property="TextBlock.Foreground" Value="White"/>
        </Style>

        <!-- Отключённая кнопка -->
        <Style Selector="Button:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="#BCAAA4"/>
            <Setter Property="TextBlock.Foreground" Value="White"/>
        </Style>

        <!-- Стили для переключателя Клуб / Ипподром -->
        <Style Selector="Border.toggle-container">
            <Setter Property="Background" Value="#4E342E"/>
            <Setter Property="CornerRadius" Value="25"/>
            <Setter Property="BorderBrush" Value="#3E2723"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
        </Style>

        <Style Selector="Button.toggle-btn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#D7CCC8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Width" Value="150"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Активная кнопка переключателя -->
        <Style Selector="Button.toggle-btn.active">
            <Setter Property="Background" Value="#E65100"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <Style Selector="Button.toggle-btn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#5D4037"/>
            <Setter Property="TextBlock.Foreground" Value="White"/>
        </Style>

        <Style Selector="Button.toggle-btn.active:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#F57C00"/>
            <Setter Property="TextBlock.Foreground" Value="White"/>
        </Style>

        <!-- Таблицы DataGrid -->
        <Style Selector="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#8D6E63"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#EFEBE9"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowHeight" Value="34"/>
        </Style>

        <Style Selector="DataGridColumnHeader">
            <Setter Property="Background" Value="#5D4037"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style Selector="DataGridCell">
            <Setter Property="Foreground" Value="#3E2723"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style Selector="DataGridCell:selected">
            <Setter Property="Background" Value="#FFE0B2"/>
            <Setter Property="Foreground" Value="#3E2723"/>
        </Style>

        <!-- Цветовая индикация статуса строки (StatusBrush из ViewModel) -->
        <Style Selector="DataGridRow">
            <Setter Property="Background" Value="{Binding StatusBrush}"/>
        </Style>

        <Style Selector="DataGridRow:selected">
            <Setter Property="Background" Value="#FFE0B2"/>
        </Style>

        <!-- ComboBox и CheckBox -->
        <Style Selector="ComboBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#3E2723"/>
            <Setter Property="BorderBrush" Value="#8D6E63"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style Selector="CheckBox">
            <Setter Property="Foreground" Value="#3E2723"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style Selector="DatePicker, TimePicker">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#3E2723"/>
            <Setter Property="BorderBrush" Value="#8D6E63"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>
    </Application.Styles>
</Application>
