<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
        x:Class="Avalo.MainWindow"
        Title="Аллюр - Конноспортивный клуб"
        Width="800" Height="600"
        WindowStartupLocation="CenterScreen">
     
    <DockPanel>
        <!-- Верхняя панель с переключателем (скрыта по умолчанию) -->
        <Border x:Name="TopPanel" DockPanel.Dock="Top" IsVisible="False" 
                Background="#F5F5F5" BorderBrush="Black" BorderThickness="0,0,0,2" Padding="15">
            
            <!-- Переключатель -->
            <Border Classes="toggle-container">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <Button x:Name="BtnClub" Classes="toggle-btn" Content="Клуб Аллюр" />
                    <Button x:Name="BtnHippodrome" Classes="toggle-btn" Content="Ипподром" />
                </StackPanel>
            </Border>
        </Border>

        <Grid>
            <ContentControl x:Name="MainContent" />
        </Grid>
    </DockPanel>
</Window>