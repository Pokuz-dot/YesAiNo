<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Avalo.MainWindow"
        Title="Аллюр — Конноспортивный клуб и ипподром"
        Width="1220" Height="820"
        MinWidth="920" MinHeight="620"
        WindowStartupLocation="CenterScreen">

    <DockPanel>
        <!-- Верхняя панель с переключателем (скрыта до входа) -->
        <Border x:Name="TopPanel" DockPanel.Dock="Top" IsVisible="False"
                Background="#F5F5F5" BorderBrush="Black" BorderThickness="0,0,0,2" Padding="10">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="16">
                <Border Classes="toggle-container">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <Button x:Name="BtnClub" Classes="toggle-btn active" Content="Клуб Аллюр"/>
                        <Button x:Name="BtnHippodrome" Classes="toggle-btn" Content="Ипподром"/>
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center">
                    <TextBlock x:Name="UserText" FontWeight="Bold" Foreground="#3E2723"/>
                    <TextBlock x:Name="RoleText" FontSize="12" Foreground="#8D6E63"/>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock x:Name="TimerText" Text="45:00" FontSize="20" FontWeight="Bold"
                               Foreground="#3E2723" VerticalAlignment="Center" MinWidth="80"/>
                    <Button x:Name="BtnTimerStart" Content="Старт" Width="70"/>
                    <Button x:Name="BtnTimerPause" Content="Пауза" Width="70"/>
                    <Button x:Name="BtnTimerReset" Content="Сброс" Width="70"/>
                </StackPanel>

                <Button x:Name="BtnLogout" Grid.Column="3" Content="Выйти" VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <Grid>
            <!-- Экран входа -->
            <StackPanel x:Name="LoginPanel" Width="330" Spacing="0"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Конноспортивный клуб «Аллюр»" FontSize="17" FontWeight="Bold"
                           Foreground="#3E2723" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
                <TextBlock Text="Авторизация" FontSize="28" FontWeight="Bold" Foreground="#3E2723"
                           HorizontalAlignment="Center" Margin="0,12,0,0"/>
                <TextBox x:Name="TxtLogin" PlaceholderText="Введите логин..." Margin="0,24,0,0"/>
                <TextBox x:Name="TxtPassword" PlaceholderText="Введите пароль..." PasswordChar="•" Margin="0,14,0,0"/>
                <CheckBox x:Name="ChkShowPassword" Content="Показать пароль" Margin="0,10,0,0"/>
                <Button x:Name="BtnLogin" Content="Войти" HorizontalAlignment="Stretch" Margin="0,18,0,0"/>
                <TextBlock x:Name="LoginError" Foreground="#C62828" FontSize="13" TextWrapping="Wrap" Margin="0,12,0,0"/>
                <TextBlock x:Name="LockoutText" Foreground="#E65100" FontWeight="Bold" FontSize="14" Margin="0,6,0,0"/>
                <TextBlock Text="Демо-доступ: bereitor / bereitor123, admin / admin123"
                           FontSize="12" Foreground="#8D6E63" TextWrapping="Wrap" Margin="0,18,0,0"/>
            </StackPanel>

            <!-- Часть 1: Клуб -->
            <ScrollViewer x:Name="ClubPanel" IsVisible="False">
                <StackPanel Spacing="14" Margin="25">
                    <TextBlock Text="Конноспортивный клуб «Аллюр»" FontSize="32" FontWeight="Bold"
                               Foreground="#3E2723" HorizontalAlignment="Center" TextAlignment="Center"/>
                    <TextBlock Text="Мир верховой езды и гармонии с лошадьми" FontSize="16"
                               FontStyle="Italic" Foreground="#8D6E63"
                               HorizontalAlignment="Center" TextAlignment="Center"/>
                    <Border Height="2" Background="#8D6E63"/>

                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
                        <TextBox x:Name="TxtSearch" Grid.Column="0" PlaceholderText="Поиск по номеру или всаднику..."/>
                        <ComboBox x:Name="CmbStatus" Grid.Column="1" Width="220"/>
                        <Button x:Name="BtnRefresh" Grid.Column="2" Content="Обновить"/>
                        <Button x:Name="BtnNewOrder" Grid.Column="3" Content="+ Новый заказ"/>
                    </Grid>

                    <TextBlock x:Name="ErrorText" Foreground="#C62828" TextWrapping="Wrap"/>

                    <TextBlock Text="Заказы на тренировки" FontSize="20" FontWeight="Bold" Foreground="#3E2723"/>
                    <DataGrid x:Name="OrdersGrid" AutoGenerateColumns="False" CanUserSortColumns="True"
                              Height="230" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Номер" Binding="{Binding OrderNum}" Width="160"/>
                            <DataGridTextColumn Header="Дата" Binding="{Binding OrderDateText}" Width="150"/>
                            <DataGridTextColumn Header="Всадник" Binding="{Binding RiderName}" Width="*"/>
                            <DataGridTextColumn Header="Сумма, руб." Binding="{Binding TotalPriceText}" Width="110"/>
                            <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="200"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="BtnOpenOrder" Content="Открыть"/>
                        <Button x:Name="BtnExport" Content="Экспорт (SHA256)"/>
                        <Button x:Name="BtnDelete" Content="Удалить"/>
                    </StackPanel>

                    <TextBlock Text="Наши лошади" FontSize="20" FontWeight="Bold" Foreground="#3E2723"/>
                    <DataGrid x:Name="HorsesGrid" AutoGenerateColumns="False" Height="180" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Кличка" Binding="{Binding Nickname}" Width="140"/>
                            <DataGridTextColumn Header="Порода" Binding="{Binding BreedName}" Width="*"/>
                            <DataGridTextColumn Header="Год рождения" Binding="{Binding BirthYear}" Width="120"/>
                            <DataGridTextColumn Header="Окрас" Binding="{Binding SuitColor}" Width="140"/>
                            <DataGridTextColumn Header="Допуск" Binding="{Binding ReadyText}" Width="140"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Text="Всадники клуба" FontSize="20" FontWeight="Bold" Foreground="#3E2723"/>
                    <DataGrid x:Name="RidersGrid" AutoGenerateColumns="False" Height="180" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ФИО" Binding="{Binding FullName}" Width="*"/>
                            <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="170"/>
                            <DataGridTextColumn Header="Уровень" Binding="{Binding SkillLevel}" Width="150"/>
                            <DataGridTextColumn Header="Скидка" Binding="{Binding DiscountText}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </ScrollViewer>

            <!-- Часть 2: Ипподром -->
            <ScrollViewer x:Name="HippodromePanel" IsVisible="False">
                <StackPanel Spacing="14" Margin="25">
                    <Border Background="#2E4A3B" CornerRadius="10" Padding="22">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Ипподром «Аллюр»" FontSize="32" FontWeight="Bold"
                                       Foreground="#F5E6C8" HorizontalAlignment="Center" TextAlignment="Center"/>
                            <TextBlock Text="Скачки, конкур и расписание манежа" FontSize="16"
                                       FontStyle="Italic" Foreground="#C8B88A"
                                       HorizontalAlignment="Center" TextAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="HippoStats" TextWrapping="Wrap" Foreground="#3E2723"/>

                    <TextBlock Text="Расписание занятий" FontSize="20" FontWeight="Bold" Foreground="#2E4A3B"/>
                    <DataGrid x:Name="ScheduleGrid" AutoGenerateColumns="False" Height="340" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Заказ" Binding="{Binding OrderNum}" Width="160"/>
                            <DataGridTextColumn Header="Дата и время" Binding="{Binding SessionText}" Width="160"/>
                            <DataGridTextColumn Header="Лошадь" Binding="{Binding HorseName}" Width="140"/>
                            <DataGridTextColumn Header="Всадник" Binding="{Binding RiderName}" Width="*"/>
                            <DataGridTextColumn Header="Минут" Binding="{Binding DurationMinutes}" Width="80"/>
                            <DataGridTextColumn Header="Тренер" Binding="{Binding TrainerText}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Text="Таймер академического часа верховой езды (45 минут) — в верхней панели. По истечении смены подаётся звуковой сигнал."
                               TextWrapping="Wrap" Foreground="#5D4037"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
